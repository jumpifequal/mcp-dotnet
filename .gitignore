# --- build output: bin/ and obj/ centralized at the repo root for the server and GUI console (see
# Directory.Build.props), and left at the per-project default under tests/ -- not anchored to the
# root, so both shapes are covered.
bin/
obj/
/artifacts
TestResults/

# --- IDE / OS
/.idea
/.vs
.vscode/
*.user
*.DotSettings.user
desktop.ini
Thumbs.db
.DS_Store
~$*

# --- secrets (TLS keys/certs for --transport http, local env files)
*.pem
*.key
*.pfx
.env
.env.*

# --- local publishing helpers (not part of the project)
Scripts/publish_me.bat
Scripts/publish-to-github.ps1

# --- distribution output (built by Scripts/pack-dist.ps1)
Distribution/
!Distribution/mcp-dotnet-*.zip
