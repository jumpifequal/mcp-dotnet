# Normalize line endings; keep shell/batch scripts in their native form.
*               text=auto
*.sh            text eol=lf
*.ps1           text eol=crlf
*.bat           text eol=crlf

# Excluded from release zips (git archive): repo/CI plumbing end users don't need.
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.claude/        export-ignore
tests/          export-ignore
